[Unit]
Description=RoadGuard nightly image cleanup
Documentation=https://github.com/orarr2/RoadGuard

[Service]
Type=oneshot
User=roadguard
Group=roadguard
WorkingDirectory=/opt/roadguard/repo
EnvironmentFile=/etc/roadguard/env
Environment=PYTHONPATH=/opt/roadguard/repo/src
ExecStart=/opt/roadguard/venv/bin/python -m jobs.image_cleanup
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/roadguard
