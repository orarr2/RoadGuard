[Unit]
Description=RoadGuard FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roadguard
Group=roadguard
WorkingDirectory=/opt/roadguard/repo
EnvironmentFile=/etc/roadguard/env
Environment=PYTHONPATH=/opt/roadguard/repo
# Chroma caches its embedding model under $HOME/.cache; the service
# user's home (/opt/roadguard) is read-only under ProtectSystem=strict.
Environment=HOME=/var/lib/roadguard
# 0.0.0.0, not 127.0.0.1: a private reverse proxy reaches the API on the
# VM's private address. The host firewall keeps the port closed to the
# public interface; only the tunnel and the private network get through.
ExecStart=/opt/roadguard/venv/bin/uvicorn roadguard_api:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
MemoryMax=700M
MemoryHigh=600M

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/roadguard /opt/roadguard/repo /opt/roadguard/models
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
