[Unit]
Description=RoadGuard FastAPI service
Documentation=https://github.com/orarr2/RoadGuard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roadguard
Group=roadguard
WorkingDirectory=/opt/roadguard/repo
EnvironmentFile=/etc/roadguard/env
Environment=PYTHONPATH=/opt/roadguard/repo/src
ExecStart=/opt/roadguard/venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
MemoryMax=700M
MemoryHigh=600M

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/roadguard /opt/roadguard/repo /opt/roadguard/models
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
