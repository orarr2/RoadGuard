# Agent LLM (primary)
AGENT_PROVIDER=groq
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=openai/gpt-oss-120b

# Multiagent LLM wiring
# ROADGUARD_USE_LIVE=1 turns on the live chat() path in Perception/Research/
# Decision. With it off, the nodes stay on their deterministic rule tree.
ROADGUARD_USE_LIVE=0

# Single-provider default (used by Perception + Research, and by Decision
# when no panel is configured). The provider can be prefixed on the model.
AGENT_LLM_PROVIDER=groq
AGENT_LLM_MODEL=openai/gpt-oss-120b

# Decision panel: 3 models from 3 different vendors. Each panelist carries
# its own provider prefix. Panel fires ONLY on the Decision node
# (use_panel=True); Perception and Research keep the cheap single-provider
# path.
AGENT_LLM_PANEL=groq:openai/gpt-oss-120b,openai_compat:meta-llama/Llama-3.3-70B-Instruct-Turbo,openai_compat:deepseek/deepseek-chat

# OpenAI-compatible endpoint credentials. Together AI and OpenRouter both
# speak this protocol; swap base_url + key when switching panel members.
OPENAI_COMPAT_BASE_URL=https://api.together.xyz/v1
OPENAI_COMPAT_API_KEY=replace_me

# Agent LLM (fallback, runs locally on the VM)
ROADGUARD_LOCAL_LLM_MODEL=/opt/roadguard/models/llama-3.2-1b-instruct-q4_k_m.gguf
ROADGUARD_LOCAL_LLM_CTX=1024
ROADGUARD_LOCAL_LLM_THREADS=2
ROADGUARD_LOCAL_LLM_MAX_TOKENS=180

# Approval gate: supervisor email + link base. Set this once the API is
# reachable; the multiagent approval_gate node skips email when empty.
ROADGUARD_APPROVAL_BASE_URL=

# Supabase (image storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_BUCKET=roadguard-hazards
ROADGUARD_IMAGE_TTL_HOURS=48

# Auth
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-passphrase', bcrypt.gensalt()).decode())"
ROADGUARD_PASSPHRASE_HASH=$2b$12$replace_me
ROADGUARD_ALLOWED_EMAILS=orarbeli1@gmail.com
GOOGLE_OAUTH_CLIENT_ID=replace_me.apps.googleusercontent.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROADGUARD_JWT_SECRET=replace_me
ROADGUARD_JWT_TTL=604800

# Rate limits (slowapi syntax)
ROADGUARD_LIMIT_PER_MIN=30/minute
ROADGUARD_LIMIT_PER_DAY=500/day
ROADGUARD_USER_LIMIT=20/minute

# Daily summary email (Gmail SMTP + App Password)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=projgithub@gmail.com
EMAIL_APP_PASSWORD=replace_me
REPORT_RECIPIENT=projgithub@gmail.com

# Paths (override on the VM)
ROADGUARD_DB_PATH=/var/lib/roadguard/roadguard.db
ROADGUARD_RAG_PATH=/var/lib/roadguard/chroma
