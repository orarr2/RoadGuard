# Agent LLM (primary provider used by Perception, Research, and single-provider Decision)
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=openai/gpt-oss-120b

# Live/offline switch
# ROADGUARD_USE_LIVE=1 turns on the live chat() path for Intake, Decision and the
# once-a-day Pattern agent inside jobs.daily_report (one call per digest);
# Perception and Research call the LLM only with their own flags below.
# With it off, nodes stay on their deterministic rule tree (eval + CI mode).
ROADGUARD_USE_LIVE=0

# Decision ReAct loop (roadmap section 8): the Decision LLM may call its four
# tools itself (tool_call -> run -> append -> call, at most 2 tool hops) on the
# single AGENT_LLM_PROVIDER path. Off until the live benchmark; when on, the
# Decision panel is not used for that hazard.
AGENT_DECISION_REACT=0

# Perception LLM refinement of the rule-based HazardProfile. Measured: on
# structured numbers it only lowers confidence. Turn on with real YOLO weights.
AGENT_PROFILE_BUILDER_LLM=0

# Research LLM relabel of the retrieval coverage. Measured: no value over
# the 15 seed passages. Turn on when a real corpus replaces them.
AGENT_RAG_RETRIEVER_LLM=0

# Per-call timeout (seconds) for every network provider. The SDK default is
# 600 s; retries are handled by the backoff in chat.py, not by the SDK.
AGENT_LLM_TIMEOUT_SECONDS=30

# Single-provider default (Perception and Research; also Decision when no panel is set)
AGENT_LLM_PROVIDER=groq
AGENT_LLM_MODEL=openai/gpt-oss-120b

# Decision panel: one model per vendor, each with its own free-tier
# daily quota, so a rate-limit on one vendor does not take the panel
# down. Fires only on Decision (use_panel=True). Majority vote +
# severity tiebreak (urgent > human_review > needs_more_evidence > standard).
# Measured 22.10.2026: gemini-3.5-flash's free tier is 20 requests per day
# (429 "Quota exceeded ... limit: 20"), so flash-lite holds the seat.
AGENT_LLM_PANEL=groq:openai/gpt-oss-120b,gemini:gemini-flash-lite-latest,mistral:mistral-small-latest

# Optional: any OpenAI-compatible endpoint (vLLM, LM Studio, OpenRouter,
# Together AI). Only used by "openai_compat:" entries in the panel or
# fallback chain. Leave blank when not in use.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Google Gemini (free tier via https://aistudio.google.com/apikey). Used
# by the "gemini:" entries in AGENT_LLM_PANEL via Google's OpenAI compat.
GEMINI_API_KEY=replace_me

# Mistral AI (console.mistral.ai, free tier). Adding Mistral to the panel
# gives us a third vendor with its own daily quota, so a Groq or Gemini
# rate-limit does not take the whole live flow down.
MISTRAL_API_KEY=replace_me

# Groq prompt caching. 1 = send cache_control hints on the system
# message (Groq-only, other providers ignore it). 0 to disable.
ROADGUARD_PROMPT_CACHE=1

# LangGraph checkpointing path (SqliteSaver).
ROADGUARD_CHECKPOINT_PATH=/var/lib/roadguard/checkpoints.sqlite

# ChromaDB persistent dir and collection (RAG for repair standards).
# Default values are for the mini_corpus.jsonl seed. To plug in Benny's
# handoff corpus (English-only, no hazard_class/road_type tags - the
# retriever will auto-fall-back to a pure semantic search):
#   1. Download the whole chroma_db/ folder from the shared Drive link
#      (chroma.sqlite3 plus the UUID subfolder with the index binaries).
#   2. Place it so the chroma.sqlite3 file lives at
#      $ROADGUARD_RAG_PATH/chroma.sqlite3.
#   3. Set ROADGUARD_RAG_COLLECTION=charter_grounded_corpus.
ROADGUARD_RAG_PATH=/var/lib/roadguard/chroma
ROADGUARD_RAG_COLLECTION=roadguard_repair_standards

# Fallback chain, comma-separated, walked in order when a provider raises
# (after its own exponential backoff). Fires on Perception / Research and
# on any panelist that errors. Put a different vendor than the one that
# just failed first, so a vendor-wide 429 is covered by the next vendor.
# After the whole chain fails the deterministic rule tree answers.
AGENT_LLM_FALLBACK=gemini:gemini-flash-lite-latest,groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash

# Public base URL of this API (the Cloudflare tunnel origin). REQUIRED for
# the approval gate to email the supervisor and for the digest PDF to
# carry approve/deny links; when empty, no approval email is sent and
# the PDF prints bare approval ids instead.
ROADGUARD_APPROVAL_BASE_URL=

# Auth
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-passphrase', bcrypt.gensalt()).decode())"
ROADGUARD_PASSPHRASE_HASH=$2b$12$replace_me
ROADGUARD_ALLOWED_EMAILS=you@example.com
GOOGLE_OAUTH_CLIENT_ID=replace_me.apps.googleusercontent.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROADGUARD_JWT_SECRET=replace_me
ROADGUARD_JWT_TTL=604800

# Rate limits (slowapi syntax). Keyed by JWT subject; passphrase users
# (shared subject) are keyed by subject + IP so one busy citizen does not
# exhaust the bucket for everyone.
ROADGUARD_LOGIN_LIMIT=10/minute
ROADGUARD_USER_LIMIT=20/minute
ROADGUARD_LIVE_LIMIT=90/minute
ROADGUARD_DECIDE_LIMIT=10/minute

# Approval email (Gmail SMTP + App Password)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=projgithub@gmail.com
EMAIL_APP_PASSWORD=replace_me
REPORT_RECIPIENT=projgithub@gmail.com

# Paths (override on the VM)
ROADGUARD_DB_PATH=/var/lib/roadguard/roadguard.db

# ROADGUARD_DRY_RUN=1 makes a process run the full graph but skip every
# side effect (approval rows, approval emails, evidence_requests rows,
# work_orders rows, LangGraph checkpoints). rg-demo forces it on itself.
# Do NOT put it in this file: the API service must never run dry.

# Budget guard caps (defaults match guards.py; the Oracle deployment runs
# WALL_CLOCK_CAP_SECONDS=240 because the local Ollama panel is CPU-bound).
WALL_CLOCK_CAP_SECONDS=30
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_HOPS=3
AGENT_COST_CAP_USD=0.10

# POST /hazards/submit-async: how many graphs run at once; later ones wait
# with the row in status 'queued'.
ROADGUARD_ASYNC_CONCURRENCY=2

# Operator-only pages (/trace, /supervisor) are served only when the
# request's Host is one of these; anything else gets 404.
ROADGUARD_PRIVATE_HOSTS=127.0.0.1,localhost

# Time zone for the clock in trace lines and the status banner (IANA name;
# empty = the host's local time).
ROADGUARD_DISPLAY_TZ=Asia/Jerusalem

# RDD2022 image folder and the target the status banner measures against.
ROADGUARD_RDD2022_DIR=data/rdd2022
ROADGUARD_RDD2022_TARGET=10000

# Browser origins allowed to call the API (comma-separated). Add the origin
# that serves the webapp, for example https://<user>.github.io
ROADGUARD_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Retention sweep inside the API (7-day checkpoints, stale evidence
# requests): runs at startup and every 6 hours. 0 disables it.
ROADGUARD_RETENTION_SWEEP=1
ROADGUARD_CHECKPOINT_PATH=./roadguard-checkpoints.sqlite
